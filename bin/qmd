#!/usr/bin/env bash
# 同梱ランチャー（~/.bun/bin/qmd）は node を優先するが、bun install -g では
# better-sqlite3 のネイティブバイナリがビルドされず node 経路は起動できない。
# qmd 本体は bun:sqlite を使う設計なので bun での実行を強制する。
BUN="$HOME/.bun/bin/bun"
QMD_JS="$HOME/.bun/install/global/node_modules/@tobilu/qmd/dist/cli/qmd.js"

if [ ! -x "$BUN" ]; then
    echo "qmd: bun が見つかりません（$BUN）。'curl -fsSL https://bun.sh/install | bash' で導入してください" >&2
    exit 127
fi

if [ ! -f "$QMD_JS" ]; then
    echo "qmd: qmd が未インストールです。'make sync' か 'bun install -g @tobilu/qmd' を実行してください" >&2
    exit 127
fi

exec "$BUN" run "$QMD_JS" "$@"
